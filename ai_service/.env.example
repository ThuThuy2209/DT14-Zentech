# Cổng chạy FastAPI của AI Service (Quy định: 5000)
PORT=5000

# Google Gemini API Key (Lấy tại https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# Model LLM sử dụng (Mặc định: gemini-3.8-flash)
DEFAULT_LLM_MODEL=gemini-3.8-flash

# Chế độ Mock AI khi chưa có API Key hoặc kiểm thử offline (true/false)
USE_MOCK_AI=false

# Thông tin đối chiếu của công ty Minh Software
COMPANY_TAX_ID=0318888888
COMPANY_NAME=Công ty TNHH Một thành viên Minh Software

# Ngưỡng số ngày quá hạn nhắc nợ (30 ngày)
OVERDUE_DAYS_THRESHOLD=30
